# ==========================================
# MultiMedAI Environment Variables Example
# ==========================================

# 1. API Configuration
API_TITLE="MultiMedAI API"
API_VERSION="1.0.0"
CORS_ORIGINS="http://localhost:3000,http://localhost"

# 2. Database (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=multimedai
# Used by FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# 3. Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# 4. MinIO (S3 compatible storage)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin_password_here
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=multimedai
MINIO_USE_SSL=false
# External URL for frontend to access MinIO (if needed)
MINIO_EXTERNAL_URL=http://localhost:9000

# 5. Qdrant (Vector Store)
QDRANT_URL=http://qdrant:6333

# 6. Ollama / LLM Service
OLLAMA_BASE_URL=http://ollama:11434
# Optional: OpenAI API Key if fallback is needed
OPENAI_API_KEY=

# 7. YOLOv11 Configuration
YOLO_MODEL_PATH=yolov11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.25

# 8. Service Weights (for Fusion Service)
WEIGHT_IMAGE=0.35
WEIGHT_TEXT=0.30
WEIGHT_PDF=0.20
WEIGHT_SENSOR=0.15
